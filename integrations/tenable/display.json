{
  "dashboard": {
    "component": "metric-dashboard",
    "title": "{integrationName} Vulnerability Summary",
    "description": "Comprehensive analysis of endpoint security posture across {integrationName} and Action1.",
    "kpis": [
      {
        "label": "ASSET SYNC RATE",
        "metric": "syncRate",
        "color": "#1D8EE6",
        "tone": "blue"
      },
      {
        "label": "PATCHABILITY RATE",
        "metric": "patchRate",
        "color": "#10b981",
        "tone": "green"
      },
      {
        "label": "TOTAL VULNERABILITIES",
        "metric": "totalCves",
        "color": "#111827",
        "tone": "gray",
        "to": "vulnerabilities"
      }
    ],
    "sections": [
      {
        "title": "Asset Intelligence Coverage",
        "cards": [
          {
            "label": "{integrationName} Inventory",
            "metric": "totalIntegrationAssets",
            "color": "#1D8EE6",
            "to": "endpoints?filter=appAssets",
            "icon": "Globe",
            "subtitle": "Active assets identified in {integrationName}"
          },
          {
            "label": "Action1 Managed",
            "metric": "totalAction1Assets",
            "color": "#10b981",
            "to": "endpoints?filter=action1Assets",
            "icon": "Server",
            "subtitle": "Endpoints under Action1 management"
          },
          {
            "label": "Audit Gap: {integrationName}",
            "metric": "missingFromIntegration",
            "color": "#f97316",
            "to": "endpoints?filter=missingApp",
            "icon": "Activity",
            "subtitle": "In Action1 but not found in {integrationName}"
          },
          {
            "label": "Audit Gap: Action1",
            "metric": "missingFromAction1",
            "color": "#ef4444",
            "to": "endpoints?filter=missingAction1",
            "icon": "AlertTriangle",
            "subtitle": "In {integrationName} but missing Action1 agent"
          }
        ]
      },
      {
        "title": "Threat Severity Profile",
        "layout": "severity-with-distribution",
        "cards": [
          {
            "label": "Critical",
            "metric": "totalCritical",
            "color": "#ef4444",
            "to": "vulnerabilities?severity=Critical",
            "icon": "ShieldAlert",
            "subtitle": "Immediate corrective action required"
          },
          {
            "label": "High",
            "metric": "totalHigh",
            "color": "#f97316",
            "to": "vulnerabilities?severity=High",
            "icon": "AlertTriangle",
            "subtitle": "Significant risk of exploitation"
          },
          {
            "label": "Medium",
            "metric": "totalMedium",
            "color": "#eab308",
            "to": "vulnerabilities?severity=Medium",
            "icon": "Activity",
            "subtitle": "Targeted remediation recommended"
          },
          {
            "label": "Low",
            "metric": "totalLow",
            "color": "#3b82f6",
            "to": "vulnerabilities?severity=Low",
            "icon": "BarChart3",
            "subtitle": "Minor security anomalies"
          }
        ]
      },
      {
        "title": "Remediation Strategy & Readiness",
        "columns": 3,
        "cards": [
          {
            "label": "Verified Patch Available",
            "metric": "totalPatchable",
            "color": "#10b981",
            "to": "vulnerabilities?status=Patch Available",
            "icon": "CheckCircle2",
            "subtitle": "Identified CVEs with available Action1 patches"
          },
          {
            "label": "No Immediate Patch",
            "metric": "totalNotPatchable",
            "color": "#ef4444",
            "to": "vulnerabilities?status=No Patch Available",
            "icon": "AlertTriangle",
            "subtitle": "Vulnerabilities requiring alternative mitigation"
          },
          {
            "label": "Unrecognized/Unknown",
            "metric": "totalUnrecognized",
            "color": "#9CA3AF",
            "to": "vulnerabilities?status=Not Recognized",
            "icon": "Cpu",
            "subtitle": "CVEs requiring further manual investigation"
          }
        ]
      }
    ]
  },
  "navigation": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "path": "dashboard",
      "icon": "Activity",
      "capability": "dashboard"
    },
    {
      "id": "endpoints",
      "label": "Endpoints",
      "path": "endpoints",
      "icon": "Server",
      "capability": "endpoints"
    },
    {
      "id": "vulnerabilities",
      "label": "Vulnerabilities",
      "path": "vulnerabilities",
      "icon": "ShieldAlert",
      "capability": "vulnerabilities"
    },
    {
      "id": "history",
      "label": "History",
      "path": "history",
      "icon": "History",
      "capability": "history"
    },
    {
      "id": "settings",
      "label": "Settings",
      "path": "settings",
      "icon": "Settings",
      "capability": "settings",
      "requiresWrite": true
    }
  ],
  "endpoints": {
    "title": "Endpoints",
    "searchPlaceholder": "Global search across endpoint columns...",
    "emptyText": "No endpoints match the current filters.",
    "defaultSort": {
      "key": "endpoint_name",
      "direction": "asc"
    },
    "columns": [
      {
        "key": "endpoint_name",
        "label": "Name",
        "type": "strong"
      },
      {
        "key": "ipv4",
        "label": "IP Address",
        "type": "monospace"
      },
      {
        "key": "os",
        "label": "OS"
      },
      {
        "key": "integration_total_vulns",
        "label": "{integrationName} Total",
        "type": "number"
      },
      {
        "key": "action1_total_vulns",
        "label": "Action1 Total",
        "type": "number"
      },
      {
        "key": "critical_vulns",
        "label": "Critical",
        "type": "severityBadge",
        "severity": "critical"
      },
      {
        "key": "high_vulns",
        "label": "High",
        "type": "severityBadge",
        "severity": "high"
      },
      {
        "key": "medium_vulns",
        "label": "Medium",
        "type": "severityBadge",
        "severity": "medium"
      },
      {
        "key": "low_vulns",
        "label": "Low",
        "type": "severityBadge",
        "severity": "low"
      },
      {
        "key": "status",
        "label": "Status",
        "type": "syncStatus"
      }
    ]
  },
  "vulnerabilities": {
    "title": "Vulnerabilities",
    "searchPlaceholder": "Global search across vulnerability columns...",
    "emptyText": "No vulnerabilities match the current filters.",
    "defaultSort": {
      "key": "severity",
      "direction": "asc"
    },
    "columns": [
      {
        "key": "cve",
        "label": "CVE",
        "type": "nistLink",
        "filterParam": "cve"
      },
      {
        "key": "severity",
        "label": "Severity",
        "type": "severityBadgeDynamic",
        "filterParam": "severityColumn"
      },
      {
        "key": "endpoint_name",
        "label": "Endpoint",
        "filterParam": "endpoint_name"
      },
      {
        "key": "plugin_name",
        "label": "Plugin Name",
        "type": "muted",
        "filterParam": "plugin_name"
      },
      {
        "key": "status",
        "label": "Status",
        "type": "patchStatus",
        "filterParam": "statusColumn"
      }
    ]
  },
  "history": {
    "title": "Run History",
    "searchPlaceholder": "Search history...",
    "emptyText": "No sync history found matching criteria.",
    "defaultSort": {
      "key": "id",
      "direction": "desc"
    },
    "columns": [
      {
        "key": "id",
        "label": "Run ID",
        "type": "runId"
      },
      {
        "key": "timestamp",
        "label": "Timestamp",
        "type": "datetime"
      },
      {
        "key": "status",
        "label": "Status",
        "type": "runStatus"
      },
      {
        "key": "assets_processed",
        "label": "Endpoints Processed",
        "type": "number"
      },
      {
        "key": "actions",
        "label": "Actions",
        "type": "historyActions",
        "sortable": false
      }
    ]
  },
  "settings": {
    "title": "Configuration",
    "validateButtonLabel": "Validate Credentials",
    "saveButtonLabel": "Save Settings",
    "scheduleTitle": "Schedule"
  }
}
