{
  "navigation": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "path": "dashboard",
      "icon": "Activity"
    },
    {
      "id": "history",
      "label": "History",
      "path": "history",
      "icon": "History",
      "hostService": "history"
    },
    {
      "id": "actions-lab",
      "label": "Actions Lab",
      "path": "actions-lab",
      "icon": "FileText",
      "requiresWrite": true
    },
    {
      "id": "settings",
      "label": "Settings",
      "path": "settings",
      "icon": "Settings",
      "requiresWrite": true,
      "hostService": "settings"
    }
  ],
  "dashboard": {
    "component": "metric-dashboard",
    "title": "{integrationName} Dashboard",
    "description": "Example operational summary for Marketplace integration developers.",
    "kpis": [
      {
        "label": "TOTAL ENDPOINTS",
        "metric": "totalEndpoints",
        "color": "#1D8EE6",
        "tone": "blue"
      },
      {
        "label": "TOTAL VULNERABILITIES",
        "metric": "totalCves",
        "color": "#111827",
        "tone": "gray"
      },
      {
        "label": "PATCHABILITY RATE",
        "metric": "patchRate",
        "color": "#10b981",
        "tone": "green"
      }
    ],
    "sections": []
  },
  "history": {
    "title": "Run History",
    "searchPlaceholder": "Search history...",
    "emptyText": "No sync history found matching criteria.",
    "defaultSort": {
      "key": "id",
      "direction": "desc"
    },
    "columns": [
      {
        "key": "id",
        "label": "Run ID",
        "type": "runId"
      },
      {
        "key": "timestamp",
        "label": "Timestamp",
        "type": "datetime"
      },
      {
        "key": "status",
        "label": "Status",
        "type": "runStatus"
      },
      {
        "key": "assets_processed",
        "label": "Items Processed",
        "type": "number"
      },
      {
        "key": "actions",
        "label": "Actions",
        "type": "historyActions",
        "sortable": false
      }
    ]
  },
  "settings": {
    "title": "Configuration",
    "validateButtonLabel": "Validate Credentials",
    "saveButtonLabel": "Save Settings",
    "scheduleTitle": "Schedule"
  },
  "customScreens": {
    "actions-lab": {
      "title": "Actions Lab",
      "description": "A developer example screen that renders three integration-owned custom actions and displays each action result.",
      "actions": [
        "inspect-settings",
        "generate-summary",
        "runtime-diagnostics"
      ]
    }
  }
}
